# SeineShop only. Copy to .env and fill values; never commit real credentials.
SESSION_SECRET=replace-with-a-random-session-secret
PUBLIC_STORE_DOMAIN=ps83if-c4.myshopify.com
PUBLIC_CHECKOUT_DOMAIN=ps83if-c4.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=replace-with-seineshop-public-storefront-token
# Set only after hosting, domain, inventory and policy checks are complete.
# PUBLIC_SITE_URL=https://www.seineshop.com
PUBLIC_INDEXABLE=false
PUBLIC_CATALOG_PREVIEW=false

# Allow only published journal URLs to be indexed while the catalog is in preparation.
PUBLIC_JOURNAL_INDEXABLE=false

# Customer account client ID and shop ID from your Shopify configuration.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=replace-with-customer-account-client-id
SHOP_ID=replace-with-shop-id
